# GEMINI_API_KEY: Required for Gemini AI API calls (OCR tool).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected in AI Studio runtime.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Canonical production domain (Netlify).
NEXT_PUBLIC_SITE_URL="https://monjazz.netlify.app"
